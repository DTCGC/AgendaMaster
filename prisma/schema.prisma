generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id              String           @id @default(uuid())
  firstName       String
  lastName        String
  email           String           @unique
  role            String           @default("PENDING")
  passwordHash    String?
  createdAt       DateTime         @default(now())
  roleAssignments RoleAssignment[]
}

model MeetingTemplate {
  id              String    @id @default(uuid())
  type            String
  schemaStructure String
  meetings        Meeting[]
}

model Meeting {
  id              String           @id @default(uuid())
  date            DateTime
  typeId          String
  theme           String?
  // Question of the Day. Persisted (rather than living only in the wizard's
  // state) so that a re-run or an update-mode entry — neither of which shows
  // Step 2 — can restore it instead of overwriting the sheet with 'TBD'.
  qotd            String?
  status          String           @default("SCHEDULED")
  googleSheetId   String?
  googleSheetUrl  String?
  template        MeetingTemplate  @relation(fields: [typeId], references: [id])
  roleAssignments RoleAssignment[]
}

model RoleAssignment {
  id         String   @id @default(uuid())
  meetingId  String
  userId     String?
  roleName   String
  assignedAt DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id])
  meeting    Meeting  @relation(fields: [meetingId], references: [id])
}

model Subscriber {
  id           String   @id @default(uuid())
  email        String   @unique
  subscribedAt DateTime @default(now())
}

model Settings {
  key   String @id
  value String
}
