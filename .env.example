# ---------------------------------------------------------------------------
# AgendaMaster environment variables
# Copy this file to `.env` and fill in real values.  Never commit `.env`.
# See docs/GOOGLE_CLOUD_SETUP.md for the Google OAuth credentials.
# ---------------------------------------------------------------------------

# Database — local dev uses a file in the project root.
# In production this points outside the app dir: file:/var/www/data/prod.db
DATABASE_URL="file:./dev.db"

# Auth.js (NextAuth) session encryption secret. Generate with: npx auth secret
AUTH_SECRET=""

# Google OAuth 2.0 credentials (member login + Sheets/Drive/Gmail API access)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Resend — used for admin broadcasts & approval notifications.
# Leave RESEND_API_KEY blank in development to mock-log emails to logs/mock-emails.md
RESEND_API_KEY=""
# The name recipients see. Use the club's name, not the app's.
RESEND_FROM_EMAIL="Downtown Coquitlam Gavel Club <info@coquitlamgavel.com>"
# Optional. Resend's free plan allows 100 emails/day (each recipient counts);
# broadcasts that would exceed it are refused. Set to 0 on a paid plan.
# RESEND_DAILY_LIMIT="100"
# Signing secret of the Resend inbound-email webhook (Resend dashboard ->
# Webhooks -> your endpoint -> Signing secret, starts with "whsec_").
# /api/webhooks/email rejects every delivery while this is unset.
RESEND_WEBHOOK_SECRET=""

# Google service account JSON key — lets ADMIN (credentials login, no Google
# OAuth) update existing agenda sheets. Paste the downloaded key file's JSON,
# ideally base64-encoded to avoid multi-line quoting issues:
#   base64 -w0 service-account-key.json      (Linux)
#   [Convert]::ToBase64String([IO.File]::ReadAllBytes("service-account-key.json"))  (PowerShell)
# See docs/GOOGLE_CLOUD_SETUP.md "Service Account" section. Optional in dev —
# without it, admin sheet editing fails with a clear configuration error.
GOOGLE_SERVICE_ACCOUNT_KEY=""

# Seed script — password for the bootstrap admin account (coquitlamgavel@gmail.com).
# If unset, the admin seed step is skipped.
SEED_ADMIN_PASSWORD=""

# Cron endpoint protection (production). Bearer token for /api/cron/archive and /api/cron/refresh-agenda.
CRON_SECRET=""
